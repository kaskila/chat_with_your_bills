# Copy to .env and change what you need. All settings are listed in app/config.py.

# BILLS_OLLAMA_HOST=http://localhost:11434
# BILLS_EXTRACT_MODEL=qwen3:4b
# BILLS_VLM_MODEL=glm-ocr
# BILLS_KEEP_ALIVE=30m
# CPU threads for the models; default: all physical cores (10 on an i7-1355U, the fastest measured)
# BILLS_NUM_THREAD=10

# auto = VLM only when a receipt fails checks; always = every receipt; never = RapidOCR only
# BILLS_VLM_MODE=auto

# BILLS_OCR_CONFIDENCE_THRESHOLD=0.85

# Chat: model that picks the query (default: the extraction model); reword answers with a second call
# BILLS_CHAT_MODEL=qwen3:4b
# BILLS_CHAT_REPHRASE=false
